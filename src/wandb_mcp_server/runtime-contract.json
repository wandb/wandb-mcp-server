    "agents": {
      "tools": [
        {"name": "get_weave_agent_conversation_tool", "access": "read", "risk": "read", "prerequisite": "trace-backend"},
        {"name": "get_weave_agent_span_stats_tool", "access": "read", "risk": "read", "prerequisite": "trace-backend"},
        {"name": "get_weave_agent_trace_tool", "access": "read", "risk": "read", "prerequisite": "trace-backend"},
        {"name": "list_weave_agent_custom_attributes_tool", "access": "read", "risk": "read", "prerequisite": "trace-backend"},
        {"name": "list_weave_agent_versions_tool", "access": "read", "risk": "read", "prerequisite": "trace-backend"},
        {"name": "list_weave_agents_tool", "access": "read", "risk": "read", "prerequisite": "trace-backend"},
        {"name": "query_weave_agent_spans_tool", "access": "read", "risk": "read", "prerequisite": "trace-backend"},
        {"name": "search_weave_agents_tool", "access": "read", "risk": "read", "prerequisite": "trace-backend"}
      ]
    },
    "aria": {
      "tools": [
        {"name": "aria_get_turn", "access": "read", "risk": "credential-forwarding", "prerequisite": "aria-https-origin"},
        {"name": "aria_get_turns", "access": "read", "risk": "credential-forwarding", "prerequisite": "aria-https-origin"},
        {"name": "aria_send_message", "access": "write", "risk": "non-idempotent-credential-forwarding", "prerequisite": "aria-https-origin"}
      ]
    },
    "raw-graphql": {
      "tools": [
        {"name": "query_wandb_graphql_tool", "access": "read", "risk": "compatibility", "prerequisite": "wandb"}
      ]
    }
  },
  "tool_profiles": {
    "models-only": {
      "groups": ["models"],
      "managed_workloads": ["shared", "dedicated"],
      "expected_tools": {"read-write": 17, "read-only": 15}
    },
    "models-weave": {
      "groups": ["models", "weave"],
      "managed_workloads": ["shared", "dedicated"],
      "expected_tools": {"read-write": 22, "read-only": 20}
    },
    "models-weave-agents": {
      "groups": ["models", "weave", "agents"],
      "managed_workloads": ["shared"],
      "expected_tools": {"read-write": 30, "read-only": 28}
