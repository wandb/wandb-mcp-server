{
  "schema_version": 1,
  "package": "wandb_mcp_server",
  "selectors": {
    "tool_profile": {
      "environment": "WANDB_MCP_TOOL_PROFILE",
      "default": "models-weave"
    },
    "access_mode": {
      "environment": "WANDB_MCP_ACCESS_MODE",
      "default": "read-write",
      "values": [
        "read-write",
        "read-only"
      ]
    },
    "workload_profile": {
      "environment": "MCP_WORKLOAD_PROFILE",
      "default": "local",
      "values": [
        "shared",
        "dedicated",
        "local"
      ]
    },
    "capacity_class": {
      "environment": "MCP_CAPACITY_CLASS",
      "default": "small",
      "values": [
        "small",
        "medium",
        "large"
      ]
    }
  },
  "legacy_tool_environment_variables": [
    "WANDB_MCP_ENABLE_WEAVE_TOOLS",
    "WANDB_MCP_ENABLE_WEAVE_AGENT_TOOLS",
    "WANDB_MCP_ENABLE_ARIA_TOOLS",
    "WANDB_MCP_ENABLE_RAW_GRAPHQL",
    "WANDB_MCP_READ_ONLY"
  ],
  "tool_groups": {
    "models": {
      "tools": [
        {"name": "compare_artifact_versions_tool", "access": "read", "risk": "read", "prerequisite": "wandb"},
        {"name": "compare_runs_tool", "access": "read", "risk": "read", "prerequisite": "wandb"},
        {"name": "create_wandb_report_tool", "access": "write", "risk": "write", "prerequisite": "wandb"},
        {"name": "diagnose_run_tool", "access": "read", "risk": "read", "prerequisite": "wandb"},
        {"name": "get_artifact_details_tool", "access": "read", "risk": "read", "prerequisite": "wandb"},
        {"name": "get_run_history_tool", "access": "read", "risk": "read", "prerequisite": "wandb"},
        {"name": "list_artifact_versions_tool", "access": "read", "risk": "read", "prerequisite": "wandb"},
        {"name": "list_entities_tool", "access": "read", "risk": "read", "prerequisite": "wandb"},
        {"name": "list_registries_tool", "access": "read", "risk": "read", "prerequisite": "wandb"},
        {"name": "list_registry_collections_tool", "access": "read", "risk": "read", "prerequisite": "wandb"},
        {"name": "list_wandb_automations_tool", "access": "read", "risk": "read", "prerequisite": "wandb"},
        {"name": "list_wandb_integrations_tool", "access": "read", "risk": "read", "prerequisite": "wandb"},
        {"name": "log_analysis_to_wandb", "access": "write", "risk": "write", "prerequisite": "wandb"},
        {"name": "probe_project_tool", "access": "read", "risk": "read", "prerequisite": "wandb"},
        {"name": "query_wandb_entity_projects", "access": "read", "risk": "read", "prerequisite": "wandb"},
        {"name": "query_wandb_tool", "access": "read", "risk": "read", "prerequisite": "wandb"},
        {"name": "search_wandb_docs_tool", "access": "read", "risk": "read", "prerequisite": "none"}
      ]
    },
    "weave": {
      "tools": [
        {"name": "count_weave_traces_tool", "access": "read", "risk": "read", "prerequisite": "trace-backend"},
        {"name": "infer_trace_schema_tool", "access": "read", "risk": "read", "prerequisite": "trace-backend"},
        {"name": "query_weave_traces_tool", "access": "read", "risk": "read", "prerequisite": "trace-backend"},
        {"name": "resolve_trace_roots_tool", "access": "read", "risk": "read", "prerequisite": "trace-backend"},
        {"name": "summarize_evaluation_tool", "access": "read", "risk": "read", "prerequisite": "trace-backend"}
