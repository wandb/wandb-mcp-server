# Weights & Biases Configuration
# Get your API key at: https://wandb.ai/authorize
WANDB_API_KEY=your-api-key

# Optional: Public W&B instance URL used for credentials and user-facing links.
# WANDB_BASE_URL=https://customer.wandb.io

# Optional: Internal server-side W&B API URL for Dedicated/Self-Managed installs.
# The Helm chart normally resolves this by topology. For a custom topology,
# supply the deployment-specific internal API origin. When explicitly set,
# W&B Models/API calls fail closed rather than retrying through WANDB_BASE_URL.
# Keep WANDB_BASE_URL public so returned links remain usable. Weave trace
# routing remains independent through WF_TRACE_SERVER_URL.
# WANDB_INTERNAL_BASE_URL=<internal-api-origin>

# Optional: Orthogonal runtime selectors. The public/STDIO defaults shown here
# expose Models plus classic Weave with local bounded tuning.
# WANDB_MCP_TOOL_PROFILE=models-weave
# WANDB_MCP_ACCESS_MODE=read-write
# MCP_WORKLOAD_PROFILE=local
# MCP_CAPACITY_CLASS=small

# Hosted W&B Agent (ARIA) tools require the explicit
# models-weave-agents-aria profile plus an approved HTTPS endpoint. The ARIA
# profile is local-only in v0.4 and is rejected by managed workloads.
# WANDB_MCP_TOOL_PROFILE=models-weave-agents-aria
# WB_AGENT_BASE_URL=https://wb-agent.wandb.ai

# Optional: Weave Tracing Configuration for MCP Operations
# Uncomment to enable detailed observability of MCP tool calls
# WF_TRACE_SERVER_URL=https://trace.wandb.ai
# WEAVE_DISABLED=false
# MCP_LOGS_WANDB_ENTITY=your-entity
# MCP_LOGS_WANDB_PROJECT=mcp-logs
# MCP_TRACE_LIST_OPERATIONS=true

# Optional: Server Logging Configuration
# MCP_SERVER_LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# Optional: HMAC-SHA256 Session Security
# MCP_SERVER_ENABLE_HMAC_SHA256_SESSIONS=true

# Optional: Secrets Provider Setup
# MCP_SERVER_SECRETS_PROVIDER=gcp
# MCP_SERVER_SECRETS_PROJECT=your-gcp-project-id
